# Copy to .env and adjust (do not commit real secrets).
# CONFIG_PATH=/absolute/path/to/config.yaml
DATABASE_DRIVER=sqlite
DATABASE_URL=file:access.db?_pragma=foreign_keys(1)
HTTP_ADDR=127.0.0.1:8080
MIGRATIONS_DIR=migrations/sqlite
# SHUTDOWN_TIMEOUT_SECONDS=30
# API_BEARER_TOKEN=set-for-non-loopback-or-production

